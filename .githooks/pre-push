#!/usr/bin/env bash
# MLGG pre-push: catches the common CI failures locally before push.
#
# README-drift slice was the historical motivation (A4/A10/F5). The pytest
# smoke slice was added 2026-05-17 after a 30-minute fire where 8 parallel
# sessions kept pushing argparse / fixture / harvest regressions that the
# old hook (ruff + drift + rag smoke only) couldn't see — each one cost a
# ~12-min CI cycle. The targeted test files below cover the recurring
# fail classes; full suite is 10+ minutes and belongs in CI, not here.
#
# Skips heavyweight tests (those still belong in CI).
#
# Activate (one-time):  make install-hooks
#                       (or: git config core.hooksPath .githooks)
#
# Bypass once:          git push --no-verify
# Skip pytest only:     MLGG_SKIP_PYTEST_HOOK=1 git push
#                       (use when you know the push doesn't touch script
#                       contracts — e.g. README-only or docs-only pushes)

set -e
cd "$(git rev-parse --show-toplevel)"

echo "==> pre-push: README drift check"
if python3 scripts/diagnostics/check_readme_stats.py; then
  :
else
  echo
  echo "[FAIL] README drift detected. Fix the counts above, then push again."
  echo "       (To bypass: git push --no-verify — only if you understand the drift)"
  exit 1
fi

# W20-P1 (W19-E4): scope ruff to files changed in THIS push, not tree-wide.
# Before: tree-wide `ruff check scripts/` blocked unrelated pushes when a
# sibling session left ruff red elsewhere → forced `git push --no-verify`
# → CI fix-forward cascade. W19-E4 measured 8x rise in PD-02 unbreaker
# commits post-W13. CI still runs full-tree ruff (ci-unit.yml) as the
# authoritative gate; this hook only protects the *pusher* from their own
# new lint regressions. Use MLGG_PRE_PUSH_STRICT=1 to opt into full-tree.
echo "==> pre-push: ruff lint (changed files only)"
if command -v ruff &>/dev/null; then
  if [ "${MLGG_PRE_PUSH_STRICT:-0}" = "1" ]; then
    echo "    (MLGG_PRE_PUSH_STRICT=1 — running full-tree ruff)"
    ruff check scripts/ --quiet
  else
    # Enumerate .py files added/modified vs origin/main (or HEAD~5 as
    # fallback for new repos / detached upstreams). Restrict to dirs
    # ruff already covers (scripts/, tests/, plugin/). Use NUL-delimited
    # output to survive spaces in paths.
    UPSTREAM="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || echo 'origin/main')"
    BASE="$(git merge-base "$UPSTREAM" HEAD 2>/dev/null || git rev-parse HEAD~5 2>/dev/null || git rev-parse HEAD)"
    CHANGED_FILES=()
    while IFS= read -r -d '' f; do
      case "$f" in
        scripts/*.py|tests/*.py|plugin/*.py|\
        scripts/**/*.py|tests/**/*.py|plugin/**/*.py)
          [ -f "$f" ] && CHANGED_FILES+=("$f")
          ;;
        *)
          # bash 3.2 (macOS default) lacks **; do a manual prefix+suffix
          # match instead.
          case "$f" in
            scripts/*|tests/*|plugin/*)
              case "$f" in
                *.py) [ -f "$f" ] && CHANGED_FILES+=("$f") ;;
              esac
              ;;
          esac
          ;;
      esac
    done < <(git diff --name-only --diff-filter=AM -z "$BASE"..HEAD 2>/dev/null || true)
    if [ "${#CHANGED_FILES[@]}" -eq 0 ]; then
      echo "    (no changed Python files in scripts/tests/plugin — skipping ruff)"
    else
      echo "    ruff on ${#CHANGED_FILES[@]} changed file(s); full-tree ruff still runs in CI"
      ruff check --quiet "${CHANGED_FILES[@]}"
    fi
  fi
else
  echo "    (ruff not installed, skipping)"
fi

echo "==> pre-push: rag-layer smoke (importorskip-aware)"
python3 -c "
try:
    from scripts.rag import rag_query
    from scripts.core.gate_rag_bridge import rag_context_for_failure
    print('    rag public API ok')
except ImportError as e:
    # sentence_transformers / optional ML deps may be absent in dev env;
    # only fail if the failure is structural (circular import etc),
    # not optional-dep.
    msg = str(e)
    if 'sentence_transformers' in msg or 'faiss' in msg or 'torch' in msg:
        print('    (optional ML dep missing — skipping smoke: ' + msg + ')')
    else:
        raise
"

if [ "${MLGG_SKIP_PYTEST_HOOK:-0}" = "1" ]; then
  echo "==> pre-push: pytest smoke slice SKIPPED (MLGG_SKIP_PYTEST_HOOK=1)"
else
  echo "==> pre-push: pytest smoke slice (~30s, covers recurring CI-red classes)"
  # Curated subset — each file pins a class of failure that has historically
  # slipped past the ruff+drift checks and landed in CI red. Keep this list
  # tight (<60s wall-clock); full suite belongs in ci-unit.
  #   - test_stress_gate_cli      : argparse --help contract, fail-loud CLI
  #   - test_check_readme_stats   : README stat parity (belt-and-braces with the drift step above)
  #   - test_disease_kb_review_check + test_disease_kb_stale_source : provenance gate fixtures
  #   - test_real_gate_codes      : harvester / experiments coupling
  if python3 -m pytest -q --tb=line -x \
       tests/test_stress_gate_cli.py \
       tests/test_check_readme_stats.py \
       tests/test_disease_kb_review_check.py \
       tests/test_disease_kb_stale_source.py \
       tests/test_real_gate_codes.py; then
    :
  else
    echo
    echo "[FAIL] pre-push smoke pytest failed. Fix the test above, then push again."
    echo "       (Bypass smoke only: MLGG_SKIP_PYTEST_HOOK=1 git push)"
    echo "       (Bypass all hooks : git push --no-verify — last resort)"
    exit 1
  fi
fi

echo "[OK] pre-push checks passed."
