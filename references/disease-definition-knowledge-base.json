{
  "version": "1.0",
  "description": "Disease definition knowledge base for clinical prediction models. Based on UK Biobank phenotyping methodology (Torralbo 2025, Eastwood 2016). Provides multi-source definition templates that can be adapted to any dataset, not just UKB.",
  "methodology_reference": {
    "framework": "Torralbo et al. A computational framework for defining and validating reproducible phenotyping algorithms of 313 diseases. Scientific Reports. 2025;15. doi:10.1038/s41598-025-05838-9",
    "diabetes_specific": "Eastwood et al. Algorithms for the Capture and Adjudication of Prevalent and Incident Diabetes in UK Biobank. PLOS ONE. 2016;11(9):e0162388.",
    "principle": "Multi-source adjudication: no single data source is sufficient. Combine ICD codes, lab values, medications, self-report, and procedures. 'Probable' case requires ≥2 concordant sources."
  },
  "evidence_layers": {
    "description": "5 evidence layers for disease case ascertainment (UKB standard)",
    "layers": [
      {
        "id": "icd",
        "name": "ICD diagnosis codes",
        "sources": [
          "hospital_inpatient",
          "death_registry",
          "cancer_registry"
        ],
        "systems": [
          "ICD-10",
          "ICD-9-CM"
        ],
        "strength": "high"
      },
      {
        "id": "lab",
        "name": "Laboratory values",
        "sources": [
          "lab_system",
          "biobank_assessment",
          "EHR_labs"
        ],
        "strength": "high"
      },
      {
        "id": "medication",
        "name": "Medication records",
        "sources": [
          "pharmacy",
          "prescription",
          "self_report_medication"
        ],
        "strength": "moderate"
      },
      {
        "id": "self_report",
        "name": "Self-reported diagnosis",
        "sources": [
          "questionnaire",
          "interview",
          "nurse_assessment"
        ],
        "strength": "low_to_moderate"
      },
      {
        "id": "procedure",
        "name": "Procedure codes",
        "sources": [
          "hospital_procedures",
          "OPCS-4",
          "CPT"
        ],
        "strength": "high"
      }
    ]
  },
  "adjudication_strategies": {
    "any_one": {
      "description": "Any single source sufficient",
      "use_case": "Screening, high sensitivity needed",
      "specificity": "low",
      "sensitivity": "high"
    },
    "at_least_two": {
      "description": "≥2 independent sources concordant",
      "use_case": "UKB gold standard, balanced",
      "specificity": "moderate-high",
      "sensitivity": "moderate"
    },
    "all_available": {
      "description": "All available sources must agree",
      "use_case": "Very strict, research cohort",
      "specificity": "very_high",
      "sensitivity": "low"
    }
  },
  "diseases": {
    "type_2_diabetes": {
      "name": "Type 2 Diabetes Mellitus",
      "icd10": [
        "E11",
        "E11.0",
        "E11.1",
        "E11.2",
        "E11.3",
        "E11.4",
        "E11.5",
        "E11.6",
        "E11.7",
        "E11.8",
        "E11.9"
      ],
      "icd9": [
        "250.00",
        "250.02"
      ],
      "lab_criteria": [
        {
          "test": "HbA1c",
          "threshold": ">=6.5%",
          "unit_alt": ">=48 mmol/mol",
          "fasting_required": false
        },
        {
          "test": "fasting_plasma_glucose",
          "threshold": ">=7.0 mmol/L",
          "unit_alt": ">=126 mg/dL",
          "fasting_required": true
        },
        {
          "test": "oral_glucose_tolerance_test",
          "threshold": ">=11.1 mmol/L",
          "unit_alt": ">=200 mg/dL",
          "fasting_required": false
        },
        {
          "test": "random_plasma_glucose",
          "threshold": ">=11.1 mmol/L",
          "note": "with symptoms only",
          "fasting_required": false
        }
      ],
      "medications": [
        "metformin",
        "glipizide",
        "glimepiride",
        "glyburide",
        "pioglitazone",
        "rosiglitazone",
        "sitagliptin",
        "saxagliptin",
        "empagliflozin",
        "dapagliflozin",
        "canagliflozin",
        "liraglutide",
        "semaglutide",
        "dulaglutide",
        "insulin_glargine",
        "insulin_detemir",
        "insulin_aspart"
      ],
      "medication_atc_codes": [
        "A10B"
      ],
      "self_report_fields": [
        "doctor_diagnosed_diabetes",
        "diabetes_diagnosed_by_doctor",
        "non_cancer_illness_code_1220"
      ],
      "exclusions": [
        {
          "condition": "type_1_diabetes",
          "icd10": [
            "E10"
          ],
          "reason": "Different pathophysiology"
        },
        {
          "condition": "gestational_diabetes",
          "icd10": [
            "O24"
          ],
          "reason": "Pregnancy-specific, may resolve"
        },
        {
          "condition": "secondary_diabetes",
          "icd10": [
            "E13"
          ],
          "reason": "Due to other conditions"
        },
        {
          "condition": "MODY",
          "note": "Maturity-Onset Diabetes of the Young, genetic testing required"
        },
        {
          "condition": "age_under_18",
          "reason": "T2D rare in children, likely T1D"
        }
      ],
      "subtypes": {
        "description": "Ahlqvist 2018 (Lancet Diabetes Endocrinol) proposed 5 T2D subtypes",
        "clusters": [
          "SAID (severe autoimmune)",
          "SIDD (severe insulin-deficient)",
          "SIRD (severe insulin-resistant)",
          "MOD (mild obesity-related)",
          "MARD (mild age-related)"
        ]
      },
      "definition_variables_to_exclude": [
        "diabetes_diagnosis",
        "diabetes_status",
        "dm_flag",
        "fasting_glucose",
        "fasting_plasma_glucose",
        "fpg",
        "hba1c",
        "ogtt",
        "ogtt_result",
        "oral_glucose_tolerance",
        "oral_glucose_tolerance_test",
        "random_glucose",
        "random_glucose_result",
        "random_plasma_glucose"
      ],
      "recommended_adjudication": "at_least_two",
      "ukb_validation": "Eastwood 2016: 75% of 'probable T2D' confirmed in primary+secondary care"
    },
