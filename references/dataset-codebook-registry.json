{
  "version": "1.1",
  "description": "Dataset-level variable codebook registry. Maps raw variable codes to clinical semantics, gating conditions, measurement protocols, and encoding requirements. Used by gates and /mlgg skill to auto-validate feature engineering code.",
  "authoritative_source": {
    "repository": "ccb-hms/NHANES-metadata (Harvard Center for Computational Biomedicine)",
    "files": [
      "references/nhanes_codebook/nhanes_variables.tsv (58794 variables, all NHANES cycles)",
      "references/nhanes_codebook/nhanes_variables_codebooks.tsv (202019 codebook entries with skip patterns)"
    ],
    "cross_validation": "21/21 variables validated against Harvard data. 0 semantic conflicts.",
    "last_validated": "2026-04-10"
  },
  "datasets": {
    "nhanes_2017_2020": {
      "full_name": "National Health and Nutrition Examination Survey 2017-2020 (Pre-Pandemic)",
      "source": "CDC/NCHS",
      "design": "stratified_multistage_cluster",
      "survey_weighted": true,
      "known_quirks": [
        "RIDAGEYR top-coded at 80 (all >=80 mapped to 80)",
        "2019-2020 cycle truncated by COVID-19",
        "P_ prefix files for 2019-2020 cycle"
      ],
      "variables": {
        "RIDAGEYR": {
          "label": "Age in years at screening",
          "type": "numeric",
          "top_coded": 80,
          "top_coded_meaning": "80 or older",
          "questionnaire": "DEMO",
          "note": "7% of adult sample at ceiling"
        },
        "RIAGENDR": {
          "label": "Gender",
          "type": "binary",
          "codes": {
            "1": "Male",
            "2": "Female"
          },
          "questionnaire": "DEMO"
        },
        "RIDRETH3": {
          "label": "Race/Hispanic origin with NH Asian",
          "type": "nominal_categorical",
          "codes": {
            "1": "Mexican American",
            "2": "Other Hispanic",
            "3": "Non-Hispanic White",
            "4": "Non-Hispanic Black",
            "6": "Non-Hispanic Asian",
            "7": "Other/Multi-Racial"
          },
          "questionnaire": "DEMO",
          "encoding_rule": "must_onehot",
          "encoding_rationale": "No ordinal relationship between racial/ethnic categories. Numeric codes are arbitrary identifiers."
        },
        "LBXGH": {
          "label": "Glycohemoglobin (HbA1c) %",
          "type": "continuous_lab",
          "questionnaire": "GHB",
          "definition_variable_for": [
            "diabetes"
          ],
          "threshold": {
            "diabetes": ">=6.5",
            "prediabetes": ">=5.7 and <6.5"
          },
          "must_exclude_if_target": true
        },
        "LBXGLU": {
          "label": "Fasting glucose (mg/dL)",
          "type": "continuous_lab",
          "questionnaire": "GLU",
          "definition_variable_for": [
            "diabetes"
          ],
          "threshold": {
            "diabetes": ">=126",
            "prediabetes": ">=100 and <126"
          },
          "must_exclude_if_target": true,
          "note": "Fasting subsample only \u2014 not all participants"
        },
        "DIQ010": {
          "label": "Doctor told you have diabetes",
          "type": "binary_with_borderline",
          "codes": {
            "1": "Yes",
            "2": "No",
            "3": "Borderline",
            "7": "Refused",
            "9": "Don't know"
          },
          "questionnaire": "DIQ",
          "definition_variable_for": [
            "diabetes"
          ],
          "must_exclude_if_target": true,
          "skip_pattern": {
            "2": "DIQ159",
            "3": "DIQ159",
            "7": "DIQ159"
          },
          "harvard_validated": true
        },
        "DIQ160": {
          "label": "Ever told you have prediabetes",
          "type": "binary",
          "codes": {
            "1": "Yes",
            "2": "No"
          },
          "questionnaire": "DIQ",
          "target_adjacent_for": [
            "diabetes"
          ],
          "must_exclude_if_target": true
        },
        "DIQ170": {
          "label": "Ever told at risk for diabetes",
          "type": "binary",
          "codes": {
            "1": "Yes",
            "2": "No"
          },
          "questionnaire": "DIQ",
          "target_adjacent_for": [
            "diabetes"
          ],
          "must_exclude_if_target": true
        },
        "DIQ172": {
          "label": "Feel could be at risk for diabetes/prediabetes",
          "type": "binary_subjective",
          "codes": {
            "1": "Yes",
            "2": "No",
            "7": "Refused",
            "9": "Don't know"
          },
          "questionnaire": "DIQ",
          "skip_pattern": {
            "2": "DIQ180",
            "7": "DIQ180",
            "9": "DIQ180"
          },
          "skip_pattern_text": "Only asked if DIQ010 != 1 AND DIQ160 != 1",
          "missingness_mechanism": "MNAR_gated_by_target",
          "target_adjacent_for": [
            "diabetes"
          ],
          "must_exclude_if_target": true,
          "common_mislabel": "Often confused with family_history_diabetes \u2014 it is NOT family history. Harvard CCB-HMS confirms label is 'Feel could be at risk for diabetes'.",
          "harvard_validated": true,
          "harvard_missing_rate_2017": "3021/8897 (34%)"
        },
        "MCQ300C": {
          "label": "Close relative had diabetes",
          "type": "binary",
          "codes": {
            "1": "Yes",
            "2": "No"
          },
          "questionnaire": "MCQ",
          "is_family_history_for": [
            "diabetes"
          ],
          "safe_as_feature": true
        },
        "BPQ020": {
          "label": "Ever told you had high blood pressure",
          "type": "binary",
          "codes": {
            "1": "Yes",
            "2": "No",
            "7": "Refused",
            "9": "Don't know"
          },
          "questionnaire": "BPQ",
          "skip_pattern": {
            "2": "BPQ080",
            "7": "BPQ080",
            "9": "BPQ080"
          },
          "gates_downstream": [
            "BPQ050A"
          ],
          "safe_as_feature": true,
          "harvard_validated": true
        },
        "BPQ050A": {
          "label": "Now taking prescribed BP medicine",
          "type": "binary_gated",
          "codes": {
            "1": "Yes",
            "2": "No",
            "7": "Refused",
            "9": "Don't know"
          },
          "questionnaire": "BPQ",
          "skip_pattern_text": "Only asked if BPQ020 = 1 (Yes). Gated by BPQ020 skip\u2192BPQ080.",
          "missingness_mechanism": "MNAR_gated_by_BPQ020",
          "missingness_true_meaning": "Never diagnosed hypertension \u2192 no medication \u2192 code as 0",
          "safe_as_feature": true,
          "encoding_rule": "fillna_with_0",
          "harvard_validated": true,
          "harvard_missing_rate_2017": "4219/6161 (68%)"
        },
        "BPXOSY1": {
          "label": "Systolic BP reading 1 (oscillometric)",
          "type": "continuous_vital",
          "questionnaire": "BPXO",
          "measurement_protocol": "exclude_from_average",
          "protocol_rationale": "First reading affected by white-coat effect. CDC NHANES protocol: use average of readings 2 and 3 only.",
          "reference": "CDC NHANES Blood Pressure Procedures Manual 2017-2020"
        },
        "BPXOSY2": {
          "label": "Systolic BP reading 2",
          "type": "continuous_vital",
          "questionnaire": "BPXO",
          "measurement_protocol": "include_in_average"
        },
        "BPXOSY3": {
          "label": "Systolic BP reading 3",
          "type": "continuous_vital",
          "questionnaire": "BPXO",
          "measurement_protocol": "include_in_average"
        },
        "SMQ020": {
          "label": "Smoked at least 100 cigarettes in life",
          "type": "binary",
          "codes": {
            "1": "Yes",
            "2": "No"
          },
          "questionnaire": "SMQ",
          "threshold_note": "100 cigarettes \u2248 5 packs. Not 'ever tried smoking'.",
          "safe_as_feature": true
        },
        "MCQ160C": {
          "label": "Ever told had coronary heart disease",
          "type": "binary_self_report_lifetime",
          "codes": {
            "1": "Yes",
            "2": "No"
          },
          "questionnaire": "MCQ",
          "reverse_causation_risk": [
            "diabetes"
          ],
          "reverse_causation_note": "DM \u2192 CVD pathway well-established. Using CHD to predict DM may capture reverse causation rather than genuine risk."
        },
        "MCQ160F": {
          "label": "Ever told had stroke",
          "type": "binary_self_report_lifetime",
          "codes": {
            "1": "Yes",
            "2": "No"
          },
          "questionnaire": "MCQ",
          "reverse_causation_risk": [
            "diabetes"
          ],
          "reverse_causation_note": "Same reverse causation concern as CHD."
        },
        "LBXTC": {
          "label": "Total cholesterol (mg/dL)",
          "type": "continuous_lab",
          "questionnaire": "TCHOL",
          "same_visit_as": [
            "LBXGH",
            "LBDHDD",
            "LBXTR"
          ],
          "post_prediction_if_target": [
            "diabetes"
          ],
          "post_prediction_rationale": "Drawn at same exam visit as HbA1c. Reflects post-diagnosis metabolic state."
        },
        "LBDHDD": {
          "label": "Direct HDL-cholesterol (mg/dL)",
          "type": "continuous_lab",
          "questionnaire": "HDL",
          "same_visit_as": [
            "LBXGH",
            "LBXTC",
            "LBXTR"
          ],
          "post_prediction_if_target": [
            "diabetes"
          ]
        },
        "LBXTR": {
          "label": "Triglycerides (mg/dL)",
          "type": "continuous_lab",
          "questionnaire": "TRIGLY",
          "same_visit_as": [
            "LBXGH",
            "LBXTC",
            "LBDHDD"
          ],
          "post_prediction_if_target": [
            "diabetes"
          ]
        }
      }
    },
    "brfss_2022": {
      "full_name": "Behavioral Risk Factor Surveillance System 2022",
      "source": "CDC",
      "design": "stratified_random_digit_dial",
      "survey_weighted": true,
      "known_quirks": [
        "_AGE80 top-coded at 80",
        "Telephone survey \u2014 self-report only, no physical exam",
        "No lab values (glucose, HbA1c, lipids unavailable)",
        "No blood pressure readings (only self-reported diagnosis)"
      ],
      "variables": {
        "_AGE80": {
          "label": "Age in years (top-coded at 80)",
          "type": "numeric",
          "top_coded": 80,
          "friendly_names": [
            "age"
          ],
          "safe_as_feature": true
        },
        "_SEX": {
          "label": "Sex",
          "type": "binary",
          "codes": {
            "1": "Male",
            "2": "Female"
          },
          "friendly_names": [
            "sex",
            "gender"
          ],
          "safe_as_feature": true
        },
        "_BMI5": {
          "label": "BMI times 100",
          "type": "numeric",
          "friendly_names": [
            "bmi",
            "bmi_x100"
          ],
          "note": "Divide by 100 for actual BMI. Self-reported height/weight (biased low vs measured).",
          "safe_as_feature": true
        },
        "DIABETE4": {
          "label": "Ever told you have diabetes",
          "type": "binary_with_borderline",
          "codes": {
            "1": "Yes",
            "2": "No",
            "3": "No/pre-diabetes",
            "4": "Gestational only"
          },
          "definition_variable_for": [
            "diabetes"
          ],
          "must_exclude_if_target": true
        },
        "BPHIGH6": {
          "label": "Ever told had high blood pressure",
          "type": "binary",
          "codes": {
            "1": "Yes",
            "2": "No"
          },
          "friendly_names": [
            "high_bp",
            "hypertension"
          ],
          "note": "Self-reported diagnosis only. NOT continuous BP measurement.",
          "safe_as_feature": true
        },
        "CVDSTRK3": {
          "label": "Ever told had stroke",
          "type": "binary",
          "codes": {
            "1": "Yes",
            "2": "No"
          },
          "friendly_names": [
            "stroke"
          ],
          "reverse_causation_risk": [
            "diabetes"
          ],
          "safe_as_feature": true
        },
        "_SMOKER3": {
          "label": "Computed smoking status",
          "type": "categorical",
          "codes": {
            "1": "Current daily",
            "2": "Current some days",
            "3": "Former",
            "4": "Never"
          },
          "friendly_names": [
            "smoking_status",
            "ever_smoked"
          ],
          "encoding_rule": "must_onehot",
          "safe_as_feature": true
        },
        "_RACE": {
          "label": "Computed race/ethnicity",
          "type": "nominal_categorical",
          "codes": {
            "1": "White",
            "2": "Black",
            "3": "Asian",
            "4": "Hispanic",
            "5": "Other"
          },
          "encoding_rule": "must_onehot",
          "friendly_names": [
            "race",
            "race_ethnicity"
          ],
          "safe_as_feature": true
        },
        "TOLDHI3": {
          "label": "Ever told had high cholesterol",
          "type": "binary",
          "codes": {
            "1": "Yes",
            "2": "No"
          },
          "friendly_names": [
            "high_cholesterol"
          ],
          "safe_as_feature": true
        },
        "CHCCOPD3": {
          "label": "Ever told had COPD",
          "type": "binary",
          "codes": {
            "1": "Yes",
            "2": "No"
          },
          "friendly_names": [
            "copd"
          ],
          "safe_as_feature": true
        }
      }
    },
    "mimic_iv": {
      "full_name": "Medical Information Mart for Intensive Care IV",
      "source": "PhysioNet (MIT)",
      "design": "single_center_icu",
      "survey_weighted": false,
      "known_quirks": [
        "Single-center (BIDMC, Boston) \u2014 limited generalizability",
        "ICU population only \u2014 sicker than general hospital",
        "Requires PhysioNet credentialed access (free after DUA)",
        "Temporal data: item availability depends on ICU day"
      ],
      "variables": {
        "220045": {
          "label": "Heart Rate",
          "type": "continuous_vital",
          "category": "vital_sign",
          "available_at": "admission",
          "safe_as_feature": true
        },
        "220050": {
          "label": "Arterial Blood Pressure systolic",
          "type": "continuous_vital",
          "category": "vital_sign",
          "available_at": "admission",
          "safe_as_feature": true
        },
        "220179": {
          "label": "Non Invasive Blood Pressure systolic",
          "type": "continuous_vital",
          "category": "vital_sign",
          "available_at": "admission",
          "safe_as_feature": true
        },
        "220210": {
          "label": "Respiratory Rate",
          "type": "continuous_vital",
          "category": "vital_sign",
          "available_at": "admission",
          "safe_as_feature": true
        },
        "223761": {
          "label": "Temperature Fahrenheit",
          "type": "continuous_vital",
          "category": "vital_sign",
          "available_at": "admission",
          "safe_as_feature": true
        },
        "220277": {
          "label": "SpO2",
          "type": "continuous_vital",
          "category": "vital_sign",
          "available_at": "admission",
          "safe_as_feature": true
        },
        "50801": {
          "label": "Alanine Aminotransferase (ALT)",
          "type": "continuous_lab",
          "category": "lab",
          "available_at": "admission_labs",
          "safe_as_feature": true
        },
        "50912": {
          "label": "Creatinine",
          "type": "continuous_lab",
          "category": "lab",
          "available_at": "admission_labs",
          "safe_as_feature": true
        },
        "50983": {
          "label": "Sodium",
          "type": "continuous_lab",
          "category": "lab",
          "available_at": "admission_labs",
          "safe_as_feature": true
        },
        "51006": {
          "label": "Blood Urea Nitrogen (BUN)",
          "type": "continuous_lab",
          "category": "lab",
          "available_at": "admission_labs",
          "safe_as_feature": true
        },
        "50931": {
          "label": "Glucose",
          "type": "continuous_lab",
          "category": "lab",
          "available_at": "admission_labs",
          "definition_variable_for": [
            "diabetes"
          ],
          "must_exclude_if_target": true
        },
        "50852": {
          "label": "Hemoglobin A1c (HbA1c)",
          "type": "continuous_lab",
          "category": "lab",
          "available_at": "day1_or_later",
          "definition_variable_for": [
            "diabetes"
          ],
          "must_exclude_if_target": true,
          "note": "Often not available at admission \u2014 ordered later in ICU stay"
        }
      }
    }
  }
}