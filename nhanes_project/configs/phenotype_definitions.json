{
  "global_forbidden_patterns": [
    "(?i)target",
    "(?i)label",
    "(?i)outcome"
  ],
  "targets": {
    "disease_risk": {
      "defining_variables": [
        "hba1c",
        "fasting_glucose",
        "doctor_told_diabetes"
      ],
      "forbidden_patterns": [
        "(?i)target",
        "(?i)label",
        "(?i)outcome",
        "(?i)hba1c",
        "(?i)fasting.?glucose",
        "(?i)diabet",
        "(?i)prediabet",
        "(?i)at.risk.diabet"
      ],
      "notes": "Type 2 diabetes defined by HbA1c>=6.5% OR self-reported doctor diagnosis (DIQ010). Definition variables must never appear as predictors.",
      "outcome_definition": {
        "adjudication": "any_one",
        "criteria": [
          {"source": "lab", "test": "HbA1c", "threshold": ">=6.5%"},
          {"source": "self_report", "question": "doctor_diagnosed_diabetes (DIQ010)"}
        ],
        "exclusions": ["type_1", "gestational", "secondary", "MODY"],
        "subtype": "type_2_diabetes",
        "time_window": "prevalent_at_baseline"
      }
    }
  }
}
