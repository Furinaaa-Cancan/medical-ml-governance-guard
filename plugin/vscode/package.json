{
  "name": "mlgg-lint",
  "displayName": "ML Leakage Guard Lint",
  "description": "Static analysis for ML code — detects data leakage, improper preprocessing, and evaluation malpractice.",
  "version": "0.1.0",
  "publisher": "ml-leakage-guard",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Furinaaa-Cancan/medical-ml-leakage-guard"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Linters", "Programming Languages"],
  "keywords": ["python", "machine-learning", "data-leakage", "lint", "medical"],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "ML Leakage Guard Lint",
      "properties": {
        "mlgg-lint.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable mlgg-lint diagnostics."
        },
        "mlgg-lint.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Path to Python interpreter with mlgg-lint installed."
        },
        "mlgg-lint.severity": {
          "type": "string",
          "default": "info",
          "enum": ["error", "warning", "info"],
          "description": "Minimum severity level to report."
        },
        "mlgg-lint.disableRules": {
          "type": "array",
          "default": [],
          "items": { "type": "string" },
          "description": "Rule IDs to disable (e.g., [\"R004\", \"R008\"])."
        },
        "mlgg-lint.runOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run linter on file save."
        },
        "mlgg-lint.runOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Run linter when a Python file is opened."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  }
}
